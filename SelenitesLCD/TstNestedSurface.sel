#!./Selene
--- Restricted functions + test nested sub surfaces
-- Lua's Test is expected to be something like :
--[[
	struct SelLCDSurfaceLua *lcd = checkSelLCDSurface(L);
	struct RestrictArea ra;

	lcd->storage->obj.cb->getFootprint(&lcd->storage->obj, &ra);
	slcd_selLog->Log('D', "Restricted Area : x,y: %d,%d w,h: %d,%d", ra.x, ra.y, ra.w, ra.h);

	if(lcd->storage->parent){
		for(uint8_t j=0; j<4; ++j){
			lcd->storage->parent->obj.cb->setCursor(&lcd->storage->parent->obj, 0, j);
			for(uint8_t i=0; i<20; ++i){
				char t[2] = { '0'+i, 0 };
				lcd->storage->parent->obj.cb->rbWriteString(&lcd->storage->parent->obj, &ra, t);
			}
		}
	}
	lcd->storage->obj.cb->Refresh(&lcd->storage->obj);
]]

Selene.Use("SelLCD")
Selene.LetsGo() -- ensure late building dependencies


	-- Init the screen handle
	-- Suitable for my BananaPI under Arch/Gentoo
local lcd = SelLCD.Init(1, 0x27, true, false)
if not lcd then
	lcd = SelLCD.Init(2, 0x27, true, false)
end
lcd:SetTiming(500, 0)

	-- Initialise the screen
lcd:Clear()
lcd:Backlight(true)
lcd:DisplayCtl(true, false, false)
lcd:SetSize(20,4)

	-- Cleaning at exit
function quit()
	lcd:Backlight(false)
	lcd:Shutdown()
	os.exit()
end
Selene.SigIntTask( quit )

lcd:Clear()

SelLog.Log('I', "Fill the screen's buffer")
for j = 0,3 do
	lcd:SetCursor(0,j)
	for i = 0,19 do
		lcd:bWriteString( string.char(0xdb) )
	end
end

lcd:DumpBuffer()
io.stdin:read'*l'

SelLog.Log('I', "Creating SubSurface")
local sub = lcd:SubSurface(3,1,14,2)

SelLog.Log('I', "Testing")
sub:Test()

lcd:DumpBuffer()
io.stdin:read'*l'


SelLog.Log('I', "Creating nested SubSurface")
local ssub = sub:SubSurface(2,0,10,4)

SelLog.Log('I', "Clearing it")
ssub:Clear()

lcd:Refresh()
lcd:DumpBuffer()

io.stdin:read'*l'

quit()

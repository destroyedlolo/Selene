#!./Selene
--- Demonstration of subSurfaces 

Selene.Use("SelLCD")
Selene.LetsGo() -- ensure late building dependencies


	-- Init the screen handle
	-- Suitable for my BananaPI under Arch/Gentoo
local lcd = SelLCD.Init(1, 0x27, true, false)
if not lcd then
	lcd = SelLCD.Init(2, 0x27, true, false)
end
lcd:SetTiming(500, 0)

	-- Initialise the screen
lcd:Clear()
lcd:Backlight(true)
lcd:DisplayCtl(true, false, false)
lcd:SetSize(20,4)

	-- Cleaning at exit
function quit()
	lcd:Backlight(false)
	lcd:Shutdown()
	os.exit()
end
Selene.SigIntTask( quit )

function filllcd()
	for j = 0,3 do
		lcd:SetCursor(0,j)
		for i = 0,19 do
			lcd:bWriteString( string.char(0xff) )
		end
	end
end

function fillsrf( srf )
	local w,h = srf:GetSize()
	for j=0,h do
		srf:SetCursor(0,j)
		for i = 0,w do
			srf:WriteString( i%10 )
		end
	end
end

function fillsrf2(srf)
	local w,h = srf:GetSize()
	for j=0,h do
		srf:SetCursor(0,j)
		for i = 0,w do
			srf:WriteString( string.char(64 + i + j*w) )
		end
	end
end



SelLog.Log('I', "Fill the screen's buffer")

filllcd()

lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Creating SubSurface")
local srf = lcd:SubSurface(3,1,15,3)

fillsrf(srf)

srf:Dump()
lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Creating inner Surface")
local srf2 = srf:Surface(3,0,5,2)
fillsrf2(srf2)

srf2:Dump()
srf:Dump()
lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Visibility 00")
srf:SetVisibility(false)
srf2:SetVisibility(false)
filllcd()
fillsrf(srf)
fillsrf2(srf2)

srf2:Dump()
srf:Dump()
lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Visibility 01")
srf:SetVisibility(true)
srf2:SetVisibility(false)
filllcd()
fillsrf(srf)
fillsrf2(srf2)

srf2:Dump()
srf:Dump()
lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Visibility 10")
srf:SetVisibility(false)
srf2:SetVisibility(true)
filllcd()
fillsrf(srf)
fillsrf2(srf2)

srf2:Dump()
srf:Dump()
lcd:Dump()
io.stdin:read'*l'

quit()

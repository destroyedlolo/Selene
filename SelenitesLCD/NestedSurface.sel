#!./Selene
--- Demonstration of subSurfaces 

Selene.Use("SelLCD")
Selene.LetsGo() -- ensure late building dependencies


	-- Init the screen handle
	-- Suitable for my BananaPI under Arch/Gentoo
local lcd = SelLCD.Init(1, 0x27, true, false)
if not lcd then
	lcd = SelLCD.Init(2, 0x27, true, false)
end
lcd:SetTiming(500, 0)

	-- Initialise the screen
lcd:Clear()
lcd:Backlight(true)
lcd:DisplayCtl(true, false, false)
lcd:SetSize(20,4)

	-- Cleaning at exit
function quit()
	lcd:Backlight(false)
	lcd:Shutdown()
	os.exit()
end
Selene.SigIntTask( quit )

SelLog.Log('I', "Fill the screen's buffer")
for j = 0,3 do
	lcd:SetCursor(0,j)
	for i = 0,19 do
		lcd:bWriteString( string.char(0xff) )
	end
end

lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Creating Surface")
local srf = lcd:Surface(3,1,15,3)

local w,h = srf:GetSize()
print(w,h)
for j=0,h do
	srf:SetCursor(0,j)
	for i = 0,w do
		srf:WriteString( i%10 )
	end
end

srf:Dump()
lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Creating inner Surface")
local srf2 = srf:Surface(3,0,5,2)
srf2:Clear()

srf2:Dump()
srf:Dump()
lcd:Dump()
io.stdin:read'*l'


quit()

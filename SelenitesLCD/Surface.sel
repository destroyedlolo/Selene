#!./Selene
--- Demonstration of subSurfaces 

Selene.Use("SelLCD")
Selene.LetsGo() -- ensure late building dependencies


	-- Init the screen handle
	-- Suitable for my BananaPI under Arch/Gentoo
local lcd = SelLCD.Init(1, 0x27, true, false)
if not lcd then
	lcd = SelLCD.Init(2, 0x27, true, false)
end
lcd:SetTiming(500, 0)

	-- Initialise the screen
lcd:Clear()
lcd:Backlight(true)
lcd:DisplayCtl(true, false, false)
lcd:SetSize(20,4)

	-- Cleaning at exit
function quit()
	lcd:Backlight(false)
	lcd:Shutdown()
	os.exit()
end
Selene.SigIntTask( quit )

SelLog.Log('I', "Fill the screen's buffer")
for j = 0,3 do
	lcd:SetCursor(0,j)
	for i = 0,19 do
		lcd:bWriteString( string.char(0xff) )
	end
end

lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Creating Surface")
local srf = lcd:Surface(5,1,10,2)
srf:Dump()

srf:Clear()
srf:Dump()
lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Writing Surface")
srf:WriteString("In Surface")
srf:SetCursor(3,1)
srf:WriteString("Too long message")

srf:Dump()
lcd:Dump()
io.stdin:read'*l'

srf:Home()
for i=1,5 do
	srf:WriteString(i)
end

srf:Dump()
lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Refreshing")
srf:Refresh()

srf:Dump()
lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Testing visibility(false)")
srf:SetVisibility(false)
for j = 0,3 do
	lcd:SetCursor(0,j)
	for i = 0,19 do
		lcd:bWriteString( string.char(0xff) )
	end
end
lcd:Refresh()

srf:Clear()
srf:WriteString("Can see me")

srf:Dump()
lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Testing visibility(true)")
srf:SetVisibility(true)

srf:Dump()
lcd:Dump()
io.stdin:read'*l'

--[[
SelLog.Log('I', "Clearing SubSurface")
sub:Clear()
lcd:Dump()

SelLog.Log('I', "Writing SubSurface")
sub:WriteString("Exceeding")

sub:SetCursor(3,1)
sub:WriteString("Text too long")

lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Refreshing the screen")
lcd:Refresh()

lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Dump from the subSurface")
sub:Dump()
--]]

quit()

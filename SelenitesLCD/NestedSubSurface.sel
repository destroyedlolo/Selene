#!Selene
-- SubSurface within another SubSurface

Selene.Use("SelLCD")
Selene.LetsGo() -- ensure late building dependencies


	-- Init the screen handle
	-- Suitable for my BananaPI under Arch/Gentoo
local lcd = SelLCD.Init(1, 0x27, true, false)
if not lcd then
	lcd = SelLCD.Init(2, 0x27, true, false)
end
lcd:SetTiming(500, 0)

	-- Initialise the screen
lcd:Clear()
lcd:Backlight(true)
lcd:DisplayCtl(true, false, false)
lcd:SetSize(20,4)

	-- Cleaning at exit
function quit()
	lcd:Backlight(false)
	lcd:Shutdown()
	os.exit()
end
Selene.SigIntTask( quit )

SelLog.Log('I', "Fill the screen's buffer")
for j = 0,3 do
	lcd:SetCursor(0,j)
	for i = 0,19 do
		lcd:bWriteString( string.char(0xff) )
	end
end

lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Creating SubSurface")
local sub = lcd:SubSurface(5,1,10,2)

SelLog.Log('I', "Clearing and writing SubSurface")
sub:Clear()
-- sub:SetCursor(3,0)
sub:WriteString("BlaBlaBlablablabla")
sub:SetCursor(0,1)
sub:WriteString("GniGniGni")

lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Creating Sub-SubSurface")
local ssub = sub:SubSurface(2,0,3,2)
ssub:Clear()

ssub:Dump()
io.stdin:read'*l'

ssub:WriteString("Prout")

SelLog.Log('I', "Refreshing by the Sub-SubSurface")

ssub:Refresh()
ssub:Dump()
io.stdin:read'*l'

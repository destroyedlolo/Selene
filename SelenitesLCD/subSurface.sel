#!./Selene
--- Demonstration of subWindows

Selene.Use("SelLCD")
Selene.LetsGo() -- ensure late building dependencies


	-- Init the screen handle
	-- Suitable for my BananaPI under Arch/Gentoo
local lcd = SelLCD.Init(1, 0x27, true, false)
if not lcd then
	lcd = SelLCD.Init(2, 0x27, true, false)
end
lcd:SetTiming(500, 0)

	-- Initialise the screen
lcd:Clear()
lcd:Backlight(true)
lcd:DisplayCtl(true, false, false)
lcd:SetSize(20,4)

	-- Cleaning at exit
function quit()
	lcd:Backlight(false)
	lcd:Shutdown()
	os.exit()
end
Selene.SigIntTask( quit )

SelLog.Log('I', "Fill the physical screen")
for j = 0,3 do
	lcd:SetCursor(0,j)
	for i = 0,19 do
		lcd:WriteString( string.char(0xdb) )
	end
end

lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Fill the screen's buffer")
for j = 0,3 do
	lcd:SetCursor(0,j)
	for i = 0,19 do
		lcd:bWriteString( string.char(0xff) )
	end
end

lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Creating SubSurface")
local sub = lcd:SubSurface(5,1,10,2)

SelLog.Log('I', "Clearing SubSurface")
sub:Clear()

SelLog.Log('I', "Writing SubSurface")
sub:WriteString("Exceeding")

sub:SetCursor(3,1)
sub:WriteString("Text too long")

lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Refreshing the screen")
local start = os.clock()
lcd:Refresh()
local full = os.clock() - start

lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Partial refresh")
sub:Clear()

start = os.clock()
lcd:Refresh()
local partial = os.clock() - start

lcd:Dump()
io.stdin:read'*l'

SelLog.Log('I', "Optimized refresh")
lcd:bClear()

sub:Home()
sub:WriteString("Exceeding")

sub:SetCursor(3,1)
sub:WriteString("Text too long")

local start = os.clock()
lcd:Refresh()
local optimized = os.clock() - start

lcd:Dump()

SelLog.Log('I', "     Full : " .. full)
SelLog.Log('I', "  Partial : " .. partial .. " -> " .. (full/partial))
SelLog.Log('I', "Optimized : " .. optimized .. " -> ".. (full/optimized))

io.stdin:read'*l'

SelLog.Log('I', "Dump from the subSurface")
sub:Dump()

quit()
